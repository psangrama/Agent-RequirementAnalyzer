# Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: default Claude model (built-in default: claude-haiku-4-5-20251001)
#   a full ID      CLAUDE_MODEL=claude-opus-5-5
#   a model name   CLAUDE_MODEL=Claude Opus 5.5
#   a shortcut     CLAUDE_MODEL=opus        (also: sonnet, haiku, fable → newest of that family)
#   always ask     CLAUDE_MODEL=pick        (shows a menu on every analyze)
# Run "reqagent models" to see which models your key can use. --model on the command line overrides this.
CLAUDE_MODEL= CLAUDE_MODEL=Claude Haiku 4.5

# GitHub token that can write issues in your repo (see README)
GITHUB_TOKEN=github_pat_...

# Optional: default repo so you can leave out --repo
# GITHUB_REPO=your-org/your-repo
